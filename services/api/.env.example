# Browser / Android public HTTPS origin, without a trailing slash.
PUBLIC_ORIGIN=https://sim.example.com
SIMLINK_PORT=8787
# Development only: also change PUBLIC_ORIGIN to http://localhost:8787.
ALLOW_INSECURE_LOCAL=0
# Explicit trusted-LAN debugging only; credentials/messages travel unencrypted.
ALLOW_INSECURE_HTTP=0
# Default remains host-only. For LAN debugging, set the host's LAN IP explicitly.
SIMLINK_BIND=127.0.0.1

# Explicit immediate proxy IPs/CIDRs only; empty ignores forwarded headers.
TRUSTED_PROXIES=
