{
  "meta": {
    "name": "SIMLink",
    "version": "0.1.0",
    "status": "implementation baseline proposal",
    "theme": "light",
    "date": "2026-09-28",
    "format": "SIMLink plain JSON; not DTCG",
    "units": "sizes use logical units: Web CSS px/rem, Android dp; type uses Web rem and Android sp"
  },
  "color": {
    "background": "#FFFFFF",
    "surfaceSubtle": "#F5F7FA",
    "surfaceSelected": "#EBF3FF",
    "primary": "#0866E6",
    "primaryHover": "#0758C7",
    "primaryPressed": "#064BA8",
    "onPrimary": "#FFFFFF",
    "textPrimary": "#172033",
    "textSecondary": "#586579",
    "textMuted": "#647084",
    "borderSubtle": "#DFE5ED",
    "borderControl": "#7C889A",
    "focus": "#0866E6",
    "successText": "#187344",
    "successSurface": "#EDF8F1",
    "warningText": "#885300",
    "warningSurface": "#FFF5E4",
    "dangerText": "#BC2436",
    "dangerSurface": "#FFF0F2",
    "disabledText": "#586579",
    "disabledSurface": "#EDF0F4",
    "incomingBubble": "#F1F3F6",
    "outgoingBubble": "#EBF3FF",
    "scrim": "#17203366"
  },
  "space": {
    "none": 0,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "pageMobile": 20,
    "xl": 24,
    "xxl": 32,
    "section": 40,
    "xxxl": 48
  },
  "radius": {
    "small": 8,
    "control": 12,
    "bubble": 16,
    "statusPanel": 16,
    "pill": 999
  },
  "border": {
    "hairline": 1,
    "selectedTab": 3,
    "focusRing": 2,
    "focusOffset": 2
  },
  "font": {
    "webSans": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Noto Sans CJK SC\", sans-serif",
    "webMono": "ui-monospace, \"SFMono-Regular\", Consolas, monospace",
    "androidSans": "system sans-serif",
    "androidMono": "system monospace"
  },
  "type": {
    "pageTitle": {
      "size": 30,
      "lineHeight": 40,
      "weight": 700
    },
    "sectionTitle": {
      "size": 20,
      "lineHeight": 28,
      "weight": 600
    },
    "body": {
      "size": 16,
      "lineHeight": 24,
      "weight": 400
    },
    "bodyStrong": {
      "size": 16,
      "lineHeight": 24,
      "weight": 600
    },
    "label": {
      "size": 14,
      "lineHeight": 20,
      "weight": 600
    },
    "meta": {
      "size": 13,
      "lineHeight": 20,
      "weight": 400
    },
    "button": {
      "size": 16,
      "lineHeight": 24,
      "weight": 600
    },
    "code": {
      "size": 36,
      "lineHeight": 44,
      "weight": 600
    }
  },
  "size": {
    "controlMinHeight": 48,
    "webTouchMin": 44,
    "androidTouchMin": 48,
    "iconSmall": 20,
    "icon": 24,
    "avatar": 36,
    "bottomNavMinHeight": 64,
    "tabMinHeight": 48,
    "inputMinHeight": 48,
    "textareaMinHeight": 128
  },
  "layout": {
    "compactBelow": 800,
    "wideFrom": 1100,
    "sidebarWidth": 192,
    "sidebarCollapsedWidth": 72,
    "inboxListMin": 360,
    "inboxListPreferred": 380,
    "inboxListMax": 400,
    "messageMaxWidth": 560,
    "authFormMaxWidth": 400,
    "desktopGutter": 24
  },
  "motion": {
    "fastMs": 120,
    "normalMs": 180,
    "reducedMs": 0,
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  }
}
