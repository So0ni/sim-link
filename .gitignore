# OS and local editor files
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
*~

# Local environment and secrets; sanitized templates stay versioned
.env
.env.*
!.env.example
!.env.*.example
!.env.template
!.env.*.template

# Runtime logs
*.log

# Session handoffs and private local operations; never source documentation
.local/
[Hh][Aa][Nn][Dd][Oo][Ff][Ff].md
[Hh][Aa][Nn][Dd][Oo][Ff][Ff]-*.md

# Local QA captures; reviewed public screenshots belong in docs/images/
/docs/qa/
/design/qa/
/apps/web/qa/

# Credentials and signing material, regardless of module
*.jks
*.keystore
*.pem
*.key
